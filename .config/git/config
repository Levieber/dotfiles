# Shared git config, linked to ~/.config/git/config.
# Name and email live in the untracked ~/.gitconfig, which git reads after
# this file, so `git config --global` writes there and never into the repo.

# Commits and tags are signed with the SSH key that's also on GitHub
[user]
  signingkey = ~/.ssh/id_ed25519.pub

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[push]
  followTags = true
  default = current
  autoSetupRemote = true

[init]
  defaultBranch = main

[core]
  editor = nvim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[include]
  path = ~/.config/delta/themes/catppuccin.gitconfig

[delta]
  line-numbers = true
  features = catppuccin-mocha

[alias]
  undo = reset --soft HEAD^

[color]
  ui = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = yellow
  changed = green
